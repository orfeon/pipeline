{
  "settings": {
    "dataflow": {
      "maxNumWorkers": 10,
      "workerMachineType": "e2-highmem-8",
      "experiments": [
        "use_runner_v2"
      ]
    }
  },
  "sources": [
    {
      "name": "BigQueryContentInput",
      "module": "bigquery",
      "parameters": {
        "query": "SELECT ContentID, Name, Abstract, Content FROM `mydataset.contents`",
        "queryLocation": "US",
        "queryTempDataset": "temp"
      }
    },
    {
      "name": "BigQueryDocInput",
      "module": "bigquery",
      "parameters": {
        "query": "SELECT DocID, Title, Text FROM `mydataset.docs`",
        "queryLocation": "US",
        "queryTempDataset": "temp"
      }
    }
  ],
  "transforms": [
    {
      "name": "OnnxContent",
      "module": "onnx",
      "inputs": [
        "BigQueryContentInput"
      ],
      "parameters": {
        "model": {
          "path": "gs://example-bucket/onnx/multilingual_v3.onnx",
          "optLevel": "BASIC_OPT",
          "executionMode": "SEQUENTIAL"
        },
        "bufferSize": 1,
        "mappings": [
          {
            "inputs": {
              "Abstract": "inputs"
            },
            "outputs": {
              "outputs": "EmbeddingAbstract"
            }
          },
          {
            "inputs": {
              "Content": "inputs"
            },
            "outputs": {
              "outputs": "EmbeddingContent"
            }
          }
        ],
        "postprocesses": [
          {
            "name": "ContentID"
          },
          {
            "name": "Name"
          },
          {
            "name": "Embedding",
            "field": "EmbeddingContent"
          },
          {
            "name": "EmbeddingAbstract"
          },
          {
            "name": "ProcessedAt",
            "func": "current_timestamp"
          }
        ]
      }
    },
    {
      "name": "OnnxDoc",
      "module": "onnx",
      "inputs": [
        "BigQueryDocInput"
      ],
      "parameters": {
        "model": {
          "path": "gs://example-bucket/onnx/multilingual_v3.onnx",
          "optLevel": "BASIC_OPT",
          "executionMode": "SEQUENTIAL"
        },
        "bufferSize": 1,
        "mappings": [
          {
            "inputs": {
              "Text": "inputs"
            },
            "outputs": {
              "outputs": "EmbeddingText"
            }
          }
        ],
        "postprocesses": [
          {
            "name": "DocID"
          },
          {
            "name": "Title"
          },
          {
            "name": "Embedding",
            "field": "EmbeddingText"
          },
          {
            "name": "ProcessedAt",
            "func": "current_timestamp"
          }
        ]
      }
    }
  ],
  "sinks": [
    {
      "name": "VectorSearchContentOutput",
      "module": "matchingEngine",
      "inputs": [
        "OnnxContent"
      ],
      "parameters": {
        "projectId": "myproject",
        "region": "us-central1",
        "indexId": "11111111111111111111",
        "method": "upsert",
        "idField": "ContentID",
        "vectorField": "Embedding"
      }
    },
    {
      "name": "VectorSearchAbstractOutput",
      "module": "matchingEngine",
      "inputs": [
        "OnnxContent"
      ],
      "parameters": {
        "projectId": "myproject",
        "region": "us-central1",
        "indexId": "22222222222222222222",
        "method": "upsert",
        "idField": "ContentID",
        "vectorField": "EmbeddingAbstract"
      }
    },
    {
      "name": "VectorSearchDocOutput",
      "module": "matchingEngine",
      "inputs": [
        "OnnxDoc"
      ],
      "parameters": {
        "projectId": "myproject",
        "region": "us-central1",
        "indexId": "33333333333333333333",
        "method": "upsert",
        "idField": "DocID",
        "vectorField": "Embedding"
      }
    }
  ]
}
