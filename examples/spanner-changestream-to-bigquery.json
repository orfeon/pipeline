{
  "sources": [
    {
      "name": "changeStream",
      "module": "spanner",
      "parameters": {
        "mode": "changeDataCapture",
        "projectId": "myproject",
        "instanceId": "myinstance",
        "databaseId": "mydatabase",
        "changeStream": {
          "changeStreamName": "TEST_STREAM",
          "metadataDatabase": "mydatabase-cdc",
          "metadataTable": "mytablecdc"
        },
        "priority": "LOW"
      }
    }
  ],
  "transforms": [
    {
      "name": "normalize",
      "module": "cdc",
      "inputs": ["changeStream"],
      "parameters": {
        "format": "spanner"
      }
    }
  ],
  "sinks": [
    {
      "name": "bigquery",
      "module": "bigquery",
      "inputs": ["normalize"],
      "parameters": {
        "table": "myproject.mydataset.${table}",
        "cdc": true,
        "ignoreUnknownValues": true
      }
    }
  ]
}
