{
  "sources": [
    {
      "name": "changeStream",
      "module": "spanner",
      "parameters": {
        "mode": "changeDataCapture",
        "projectId": "myproject",
        "instanceId": "myinstance",
        "databaseId": "mydatabase",
        "changeStream": {
          "changeStreamName": "TEST_STREAM",
          "metadataDatabase": "mydatabase-cdc",
          "metadataTable": "mytablecdc"
        },
        "priority": "LOW"
      }
    }
  ],
  "transforms": [
    {
      "name": "normalize",
      "module": "cdc",
      "inputs": ["changeStream"],
      "parameters": {
        "format": "spanner"
      }
    },
    {
      "name": "tables",
      "module": "partition",
      "inputs": ["normalize"],
      "parameters": {
        "exclusive": true,
        "partitions": [
          {
            "name": "MyTable1",
            "filter": { "key": "table", "op": "=", "value": "MyTable1" }
          },
          {
            "name": "MyTable2",
            "filter": { "key": "table", "op": "=", "value": "MyTable2" }
          }
        ]
      }
    }
  ],
  "sinks": [
    {
      "name": "bigqueryMyTable1",
      "module": "bigquery",
      "inputs": ["tables.MyTable1"],
      "parameters": {
        "table": "myproject.mydataset.mytable1",
        "cdc": true
      }
    },
    {
      "name": "bigqueryMyTable2",
      "module": "bigquery",
      "inputs": ["tables.MyTable2"],
      "parameters": {
        "table": "myproject.mydataset.mytable2",
        "cdc": true
      }
    }
  ]
}
